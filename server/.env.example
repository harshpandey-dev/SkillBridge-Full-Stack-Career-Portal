# Server environment variables
# Copy this file to .env and fill in your values

# App Environment
NODE_ENV=development
PORT=3000

# PostgreSQL (Neon / Supabase / Self-Hosted)
# DATABASE_URL: Pooled connection string (with ?pgbouncer=true or -pooler for high concurrency)
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL: Direct unpooled connection string (required by Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.neon.tech/neondb?sslmode=require"

# JWT Authentication
# In production, JWT_SECRET must be explicitly set to a high-entropy string (min 32 chars). Fallbacks are rejected.
JWT_SECRET=change_this_to_a_long_random_secret_min_32_characters
JWT_EXPIRES_IN=7d

# HTTP-Only Cookie Configuration
# COOKIE_SAME_SITE: 'lax' (default for unified/same-site domains), 'strict', or 'none' (for cross-site, e.g. Vercel + Render)
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN: Optional shared root domain across subdomains (e.g., .skillbridge.com)
# COOKIE_DOMAIN=.skillbridge.com

# CORS Configuration
# Allowed frontend origins. Supports a single origin or comma-separated list.
# Trailing slashes are automatically trimmed.
CLIENT_ORIGIN=http://localhost:5173

# Rate Limiting (express-rate-limit)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
