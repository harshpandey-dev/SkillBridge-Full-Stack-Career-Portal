# Client Environment Variables
# Copy this file to .env and fill in your values

# API Base URL
# Option A (Local Development with Vite Proxy):
# VITE_API_URL=/api/v1
#
# Option B (Separate Production Deployment, e.g., Vercel + Render):
# VITE_API_URL=https://your-backend-api.onrender.com/api/v1
#
# Option C (Custom Domain / Unified Reverse Proxy):
# VITE_API_URL=https://api.skillbridge.com/api/v1
VITE_API_URL=/api/v1
